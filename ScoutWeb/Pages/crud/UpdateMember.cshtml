@page "{id:int}"
@model ScoutWeb.Pages.crud.UpdateMemberModel
@using ScoutLibrary.Models


<!-- Update member form-->
@if (Model.memberToUpdate != null)
{
    if (Model.memberToUpdate.IsLeader)
    {
        <form method="post" asp-page-handler="LeaderUpdateMember">
        
            <div asp-validation-summary="All" class="error-message"></div>
        
            <div>
                <label asp-for="LeaderInput.FirstName">Fornavn</label>
                <input asp-for="LeaderInput.FirstName" value="@Model.memberToUpdate.FirstName"/>
                <span asp-validation-for="LeaderInput.FirstName" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="LeaderInput.LastName">Efternavn</label>
                <input asp-for="LeaderInput.LastName" value="@Model.memberToUpdate.LastName"></input>
                <span asp-validation-for="LeaderInput.LastName" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="LeaderInput.DateOfBirth"></label>
                <input asp-for="LeaderInput.DateOfBirth" type="date" value="@Model.memberToUpdate.DateOfBirth"/>
                <span asp-validation-for="LeaderInput.DateOfBirth" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="LeaderInput.PhoneNumber"></label>
                <input asp-for="LeaderInput.PhoneNumber" value="@Model.memberToUpdate.PhoneNumber"/>
                <span asp-validation-for="LeaderInput.PhoneNumber" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="LeaderInput.Username"></label>
                <input asp-for="LeaderInput.Username" value="@Model.memberToUpdate.Username"/>
                <span asp-validation-for="LeaderInput.Username" class="text-danger"></span>
            </div>


            <div>
                <label asp-for="LeaderInput.IsLeader"></label>
                <input asp-for="LeaderInput.IsLeader" type="checkbox" value="@Model.memberToUpdate.IsLeader"/>
            </div>

            <button type="submit">Update</button>
        
            <a asp-page="/Index">Fortryd</a>
        </form>
    }
    else if (!Model.memberToUpdate.IsLeader)
    {
        <form method="post" asp-page-handler="ScoutUpdateMember">
            
            <div asp-validation-summary="All" class="error-message"></div>

            <div>
                <label asp-for="ScoutInput.PhoneNumber"></label>
                <input asp-for="ScoutInput.PhoneNumber" value="@Model.memberToUpdate.PhoneNumber"/>
                <span asp-validation-for="ScoutInput.PhoneNumber" class="text-danger"></span>
            </div>

            <button type="submit">Updater</button>

            <a asp-page="/Index">Fortryd</a>
        </form>
    }
    
}
else
{
    <p>Couldnt find member</p>
    <a asp-page="/Index">Go back to home page</a>
}
<!-- end -->
