@page "{id:int}"
@model ScoutWeb.Pages.crud.UpdateMemberModel
@using ScoutLibrary.Models


<!-- Update member form-->
@if (Model.memberToUpdate != null)
{
    <form method="post" asp-page-handler="UpdateMember">
        
        <div asp-validation-summary="All" class="error-message"></div>
        
        <div>
            <label asp-for="Input.FirstName">Fornavn</label>
            <input asp-for="Input.FirstName" value="@Model.memberToUpdate.FirstName"/>
            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Input.LastName">Efternavn</label>
            <input asp-for="Input.LastName" value="@Model.memberToUpdate.LastName"></input>
            <span asp-validation-for="Input.LastName" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Input.DateOfBirth"></label>
            <input asp-for="Input.DateOfBirth" type="date" value="@Model.memberToUpdate.DateOfBirth"/>
            <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Input.PhoneNumber"></label>
            <input asp-for="Input.PhoneNumber" value="@Model.memberToUpdate.PhoneNumber"/>
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Input.Username"></label>
            <input asp-for="Input.Username" value="@Model.memberToUpdate.Username"/>
            <span asp-validation-for="Input.Username" class="text-danger"></span>
        </div>


        <div>
            <label asp-for="Input.IsLeader"></label>
            <input asp-for="Input.IsLeader" type="checkbox" value="@Model.memberToUpdate.IsLeader"/>
        </div>

        <button type="submit">Update</button>
        
        <a asp-page="/Index">Fortryd</a>
    </form>
}
else
{
    <p>Couldnt find member</p>
    <a asp-page="/Index">Go back to home page</a>
}
<!-- end -->
