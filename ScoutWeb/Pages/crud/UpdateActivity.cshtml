@page "{id:int}"
@model ScoutWeb.Pages.crud.UpdateActivityModel
@{
    ViewData["Title"] = "Rediger Aktivitet";
}

<h2>Rediger Aktivitet</h2>

<form method="post">
    <input type="hidden" asp-for="ActivityId" />

    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <label asp-for="Name">Navn:</label><br />
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <div>
        <label asp-for="DateTime">Dato og tid:</label><br />
        <input asp-for="DateTime" type="datetime-local" />
        <span asp-validation-for="DateTime"></span>
    </div>

    <div>
        <label asp-for="Description">Beskrivelse:</label><br />
        <textarea asp-for="Description"></textarea>
        <span asp-validation-for="Description"></span>
    </div>

    <div>
        <label asp-for="MaxCount">Maksimalt antal deltagere:</label><br />
        <input asp-for="MaxCount" type="number" />
        <span asp-validation-for="MaxCount"></span>
    </div>

    <div>
        <label asp-for="MinAge">Minimumsalder:</label><br />
        <input asp-for="MinAge" type="number" />
        <span asp-validation-for="MinAge"></span>
    </div>

    <div>
        <label asp-for="SelectedMembersId">Vælg Medlemmer / Leder(e):</label><br />
        <select asp-for="SelectedMembersId" multiple>
            @if (Model.allMembers != null)
            {
                @foreach (var member in Model.allMembers)
                {
                    <option value="@member.MemberId">@member.FirstName @member.LastName (@(member.IsLeader ? "Leder" : "Medlem"))</option>
                }
            }
        </select>
        <span asp-validation-for="SelectedMembersId"></span>
    </div>

    <div>
        <label asp-for="SelectedBadgesId">Påkrævede Badges:</label><br />
        <select asp-for="SelectedBadgesId" multiple>
            @if (Model.allBadges != null)
            {
                @foreach (var badge in Model.allBadges)
                {
                    <option value="@badge.BadgeId">@badge.Name</option>
                }
            }
        </select>
        <span asp-validation-for="SelectedBadgesId"></span>
    </div>

    <div>
        <button type="submit">Gem ændringer</button>
        <a asp-page="../Index">Annuller</a>
    </div>
</form>