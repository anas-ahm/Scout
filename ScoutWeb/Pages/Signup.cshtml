@page "/registrer"
@model ScoutWeb.Pages.SignupModel
@{
    ViewData["Title"] = "Opret bruger";
}

<div class="form-page form-page--auth">
    <h1 class="form-page__title">Opret bruger</h1>

    <form method="post" class="form">
        <div asp-validation-summary="ModelOnly" class="form__summary"></div>

        <div class="form__field">
            <label asp-for="Input.FirstName">Fornavn</label>
            <input asp-for="Input.FirstName" autocomplete="given-name" autofocus />
            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
        </div>

        <div class="form__field">
            <label asp-for="Input.LastName">Efternavn</label>
            <input asp-for="Input.LastName" autocomplete="family-name" />
            <span asp-validation-for="Input.LastName" class="text-danger"></span>
        </div>

        <div class="form__field">
            <label asp-for="Input.DateOfBirth">Fødselsdato</label>
            <input asp-for="Input.DateOfBirth" type="date" autocomplete="bday" />
            <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
        </div>

        <div class="form__field">
            <label asp-for="Input.PhoneNumber">Telefonnummer</label>
            <input asp-for="Input.PhoneNumber" type="tel" autocomplete="tel" />
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </div>

        <div class="form__field form__field--full">
            <label asp-for="Input.Username">Brugernavn</label>
            <input asp-for="Input.Username" autocomplete="username" />
            <span asp-validation-for="Input.Username" class="text-danger"></span>
        </div>

        <div class="form__field">
            <label asp-for="Input.Password">Adgangskode</label>
            <input asp-for="Input.Password" type="password" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="form__field">
            <label asp-for="Input.ConfirmPassword">Bekræft adgangskode</label>
            <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="form__actions">
            <button type="submit" class="btn btn--block">Opret bruger</button>
        </div>
    </form>

    <p class="form-page__footer">Er du allerede medlem? <a asp-page="/Login">Log ind her</a></p>
</div>
