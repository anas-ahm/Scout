@page
@model ScoutWeb.Pages.LoginModel
@{
    ViewData["Title"] = "Log ind";
}

<div class="form-page form-page--auth">
    <h1 class="form-page__title">Log ind</h1>

    <form method="post" class="form">
        <div asp-validation-summary="ModelOnly" class="form__summary"></div>

        <div class="form__field form__field--full">
            <label asp-for="Input.Username">Brugernavn</label>
            <input asp-for="Input.Username" autocomplete="username" autofocus />
            <span asp-validation-for="Input.Username" class="text-danger"></span>
        </div>

        <div class="form__field form__field--full">
            <label asp-for="Input.Password">Adgangskode</label>
            <input asp-for="Input.Password" type="password" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="form__actions">
            <button type="submit" class="btn btn--block">Log ind</button>
        </div>
    </form>

    <p class="form-page__footer">Er du ikke medlem endnu? <a asp-page="/Signup">Bliv medlem i dag</a></p>
</div>