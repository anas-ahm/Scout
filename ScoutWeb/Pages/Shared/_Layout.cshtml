@{
    // Marks the link for the page being viewed (aria-current="page"), no JavaScript needed.
    // Returning null makes Razor leave the attribute out completely.
    string? currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    string? Current(string page) =>
        string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}
<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ScoutWeb</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Bundle of all <Page>.cshtml.css files (ASP.NET CSS isolation) -->
    <link rel="stylesheet" href="~/ScoutWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Spring til indhold</a>

    <header class="site-header">
        <nav class="site-nav" aria-label="Hovedmenu">
            <a class="site-nav__brand" asp-page="/Index">Roskilde Spejder Klub</a>

            <ul class="site-nav__list site-nav__list--end">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li><a asp-page="/Logout">Log ud</a></li>
                }
                else
                {
                    <li><a asp-page="/Login" aria-current="@Current("/Login")">Log ind</a></li>
                    <li><a class="site-nav__cta" asp-page="/Signup" aria-current="@Current("/Signup")">Opret bruger</a></li>
                }
            </ul>
        </nav>
    </header>

    <main id="main" class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>&copy; 2026 - ScoutWeb - <a asp-page="/Privacy">Privacy</a></p>
    </footer>

    @* Optional: pages can still add their own scripts later *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
