@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!-- SuccesMessage after redirects-->
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}
<!-- end -->


<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<!-- Temporary element to display logged-in user for testing auth and cookies -->
<p>@(@Model.Member != null ? $"Logget ind som: {@Model.Member.GetFullName()} ({@Model.Member.Username})" : "Ikke logget ind")</p>


<!-- Button for create Scout for leaders -->
<a asp-page="/crud/CreateMember">Opret Spejder</a>
<!-- end -->

<a asp-page="/Login">Log ind</a>