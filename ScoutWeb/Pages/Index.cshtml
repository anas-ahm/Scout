@page
@model IndexModel
@using ScoutLibrary.Models
@{
    ViewData["Title"] = "Home page";
}

<!-- SuccesMessage after redirects-->
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}
<!-- end -->



<!-- Pop up confirmation for deletion of member-->
@if (Model.memberToDelete != 0)
{
    <div class="alert alert-warning">
        <p>Er du sikker på, at du vil slette denne spejder?</p>
        <form method="post" asp-page-handler="ConfirmMemberDeletion">
            <input type="hidden" name="id" value="@Model.memberToDelete" />
            <button type="submit">Ja, slet</button>
            <a asp-page="/Index">Annuller</a>
        </form>
    </div>
}
<!-- end -->



<!-- ErrorMessages after calls -->
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @Model.ErrorMessage
    </div>
}
<!-- end -->



<div class="text-center">
    <h1>Velkommen [person] </h1>
</div>


<!-- Button for create Activity for leaders -->
<a asp-page="/crud/CreateActivity">Opret Aktivitet</a>
<!-- end -->

<!--Liste oversigt over alle aktiviter-->
<h1>Aktiviteter</h1>
<table class="table">
    <thead>
        <tr>
            <th>Dato</th>
            <th>Tid</th>
            <th>Navn</th>
            <th>Max Antal</th>
            <th>Min Alder</th>
            <th>Deltagere</th>
            <th>Handling</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Activity a in Model.AllActivities)
        {
            <tr>
                <!-- Split DateTime into Date and Time -->
                <td>@a.DateTime.ToString("yyyy-MM-dd")</td>
                <td>@a.DateTime.ToString("HH:mm")</td>

                <!-- Activity properties -->
                <td>@a.Name</td>
                <td>@a.MaxCount</td>
                <td>@a.MinAge</td>

                <!-- Displaying Members/Leaders (showing their names or count) -->
                <td>
                    @if (a.Members != null && a.Members.Count > 0)
                    {
                        @string.Join(", ", a.Members.Select(m => m.FirstName))
                    }
                    else
                    {
                        <span class="text-muted">Ingen tilmeldte</span>
                    }
                </td>

                <!--MODAL popup med ren HTML!___________ #Invoker Command API HTML attributes-->
                <td>
                    <button type="button" command="show-modal" commandfor="delete-dialog-@a.ActivityId">
                        Slet
                    </button>                
                    <!-- 2. Selve dialogen med unikt ID -->
                    <dialog id="delete-dialog-@a.ActivityId">
                        <p>Vil du slette aktiviteten <strong>@a.Name</strong>?</p>

                        <div>
                            <!-- Fortryd-knap: Lukker dialogen igen uden at gøre noget -->
                            <button type="button" command="close" commandfor="delete-dialog-@a.ActivityId">
                                Fortryd
                            </button>

                            <!-- Bekræft-knap: Sender data til din C#-PageHandler med ID -->
                            <form method="post" asp-page-handler="DeleteActivity" asp-route-id="@a.ActivityId" style="display:inline;">
                                <button type="submit">Bekræft</button>
                            </form>
                        </div>
                    </dialog>
                </td>
                <!--MODAL popup med ren HTML slut__________________________________________-->

           </tr>
        }
    </tbody>
</table>




<!-- Button for create Scout for leaders -->
<a asp-page="/crud/CreateMember">Opret Spejder</a>
<!-- end -->

<!-- List over all Scouts-->
<h1>Medlemmer</h1>
@foreach (Member member in Model.memberList)
{
    <div class="member">
        <span>@member.FirstName @member.LastName</span>
        <span>@member.DateOfBirth.ToString("dd-MM-yyyy")</span>
        <span>@member.PhoneNumber</span>
        <span>@member.Username</span>
        <span>@(member.IsLeader ? "Leder" : "Spejder")</span>
        
        <a asp-page="/crud/MemberDetails" asp-route-id="@member.MemberId">Se Detaljer</a>
        
        <form method="post" asp-page-handler="AskDeletion">
            <input type="hidden" name="id" value="@member.MemberId" />
            <button type="submit">Slet</button>
        </form>
        
    </div>
}
<!-- end -->



