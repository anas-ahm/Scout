@page
@model IndexModel
@using ScoutLibrary.Models
@{
    ViewData["Title"] = "Home page";
}

<!-- SuccesMessage after redirects-->
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="success-message" role="alert">
        @successMessage
    </div>
}
<!-- end -->


<!-- ErrorMessages after calls -->
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="error-message" role="alert">
        @Model.ErrorMessage
    </div>
}
<!-- end -->

<!-- ErrorMessage after redirects (for instance: member not found on the details page) -->
@if (TempData["ErrorMessage"] is string redirectedErrorMessage)
{
    <div class="error-message" role="alert">
        @redirectedErrorMessage
    </div>
}
<!-- end -->



<!-- Personal profile section -->
<div class="text-center">
    <h1>Velkommen @(@Model.LoggedInMember != null ? @Model.LoggedInMember.GetFullName() : "gæst") </h1>
    
    @if (Model.LoggedInMember != null)
    {
        <a asp-page="/crud/MemberDetails" asp-route-id="@Model.LoggedInMember.MemberId">Se mine personlige oplysninger</a>
        <a asp-page="/crud/UpdateMember" asp-route-id="@Model.LoggedInMember.MemberId">Rediger mine oplysninger</a>
    }
</div>
<!-- end -->



<!-- Button for create Activity for leaders -->
<a asp-page="/crud/CreateActivity">Opret Aktivitet</a>
<!-- end -->


<form method="get">
    <label asp-for="SearchQuery">Søg:</label>
    <input asp-for="SearchQuery" placeholder="Indtast navn, spejdertegn, alder ..." />
    <button type="submit">Søg</button>
</form>
<!--Liste oversigt over alle aktiviter-->
<h1>Aktiviteter</h1>
<table class="table">
    <thead>
        <tr>
            <th>Dato</th>
            <th>Tid</th>
            <th>Navn</th>
            <th>Max Antal</th>
            <th>Min Alder</th>
            <th>Deltagere</th>
            <th>Handling</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Activity a in Model.AllActivities)
        {
            <tr>
                <!-- Split DateTime into Date and Time -->
                <td>@a.DateTime.ToString("yyyy-MM-dd")</td>
                <td>@a.DateTime.ToString("HH:mm")</td>

                <!-- Activity properties -->
                <td>@a.Name</td>
                <td>@a.MaxCount</td>
                <td>@a.MinAge</td>

                <!-- Displaying Members/Leaders (showing their names or count) -->
                <td>
                    @if (a.Members != null && a.Members.Count > 0)
                    {
                        @string.Join(", ", a.Members.Select(m => m.FirstName))
                    }
                    else
                    {
                        <span class="text-muted">Ingen tilmeldte</span>
                    }
                </td>
<!--EDIT DELETE BUTTONS FOR ACTIIVTY - LEADER ONLY***********************************************-->
                <td>
                    <div>
                        <a asp-page="/crud/ActivityDetails" asp-route-id="@a.ActivityId" style="display:inline">
                            Se mere
                        </a>
                    </div>

                    <div>
                        <a asp-page="/crud/UpdateActivity" asp-route-id="@a.ActivityId" style="display:inline">
                            Rediger
                        </a>
                    </div>

                    <!--MODAL popup med ren HTML!___________ #Invoker Command API HTML attributes-->
                    <button type="button" command="show-modal" commandfor="delete-dialog-@a.ActivityId">
                        Slet
                    </button>
                    <!-- 2. Selve dialogen med unikt ID -->
                    <dialog id="delete-dialog-@a.ActivityId">
                        <p>Vil du slette aktiviteten <strong>@a.Name</strong>?</p>

                        <div>
                            <!-- Fortryd-knap: Lukker dialogen igen uden at gøre noget -->
                            <button type="button" command="close" commandfor="delete-dialog-@a.ActivityId">
                                Fortryd
                            </button>

                            <!-- Bekræft-knap: Sender data til din C#-PageHandler med ID -->
                            <form method="post" asp-page-handler="DeleteActivity" asp-route-id="@a.ActivityId" style="display:inline;">
                                <button type="submit">Bekræft</button>
                            </form>
                        </div>
                    </dialog>
                    <!--MODAL popup med ren HTML slut__________________________________________-->
                    
                    @if (Model.LoggedInMember != null)
                    {
                        if (!Model.AssignedActivityIds.Contains(a.ActivityId))
                        {
                            <form method="post" asp-page-handler="AssignActivity" asp-route-activityId="@a.ActivityId">
                                <button type="submit">Tilmeld aktivitet</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="UnAssignActivity" asp-route-activityId="@a.ActivityId" onsubmit="return confirm('Er du sikker på, at du vil afmelde denne aktivitet?');">
                                <button type="submit" >Afmeld aktivitet</button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>




<!-- Button for create Scout for leaders -->
<a asp-page="/crud/CreateMember">Opret Spejder</a>
<!-- end -->

<!-- Show login/logout links depending on whether the user is authenticated or not -->
@if (User.Identity.IsAuthenticated)
{
    <a asp-page="/Logout">Log ud</a>
}
else
{
    <a asp-page="/Login">Log ind</a>
}


<!-- List over all Scouts-->
<h1>Medlemmer</h1>
@foreach (Member member in Model.memberList)
{
    <div class="member">
        <span>@member.FirstName @member.LastName</span>
        <span>@member.DateOfBirth.ToString("dd-MM-yyyy")</span>
        <span>@member.PhoneNumber</span>
        <span>@member.Username</span>
        <span>@(member.IsLeader ? "Leder" : "Spejder")</span>
        
        <a asp-page="/crud/MemberDetails" asp-route-id="@member.MemberId">Se Detaljer</a>
        
        <form method="post" asp-page-handler="ConfirmMemberDeletion" asp-route-id="@member.MemberId"
              onsubmit="return confirm('Er du sikker på, at du vil slette denne spejder?');">
            <button type="submit">Slet</button>
        </form>
        
        <a asp-page="/crud/UpdateMember" asp-route-id="@member.MemberId">Rediger</a>
        
    </div>
}
<!-- end -->



