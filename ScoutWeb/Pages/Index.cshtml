@page
@model IndexModel
@using ScoutLibrary.Models
@{
    ViewData["Title"] = "Home page";
}

<!-- SuccesMessage after redirects-->
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="success-message" role="alert">
        @successMessage
    </div>
}
<!-- end -->



<!-- ErrorMessages after calls -->
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="error-message" role="alert">
        @Model.ErrorMessage
    </div>
}
<!-- end -->



<div class="text-center">
    <h1>Velkommen @(@Model.LoggedInMember != null ? @Model.LoggedInMember.GetFullName() : "gæst") </h1>
</div>


<!-- Button for create Activity for leaders -->
<a asp-page="/crud/CreateActivity">Opret Aktivitet</a>
<!-- end -->



<!--Liste oversigt over alle aktiviter-->
<h1>Aktiviteter</h1>
<table class="table">
    <thead>
        <tr>
            <th>Dato</th>
            <th>Tid</th>
            <th>Navn</th>
            <th>Max Antal</th>
            <th>Min Alder</th>
            <th>Deltagere</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Activity a in Model.AllActivities)
        {
            <tr>
                <!-- Split DateTime into Date and Time -->
                <td>@a.DateTime.ToString("yyyy-MM-dd")</td>
                <td>@a.DateTime.ToString("HH:mm")</td>

                <!-- Activity properties -->
                <td>@a.Name</td>
                <td>@a.MaxCount</td>
                <td>@a.MinAge</td>

                <!-- Displaying Members/Leaders (showing their names or count) -->
                <td>
                    @if (a.Members != null && a.Members.Count > 0)
                    {
                        @string.Join(", ", a.Members.Select(m => m.FirstName))
                    }
                    else
                    {
                        <span class="text-muted">Ingen tilmeldte</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>




<!-- Button for create Scout for leaders -->
<a asp-page="/crud/CreateMember">Opret Spejder</a>
<!-- end -->

<!-- Show login/logout links depending on whether the user is authenticated or not -->
@if (User.Identity.IsAuthenticated)
{
    <a asp-page="/Logout">Log ud</a>
}
else
{
    <a asp-page="/Login">Log ind</a>
}


<!-- List over all Scouts-->
<h1>Medlemmer</h1>
@foreach (Member member in @Model.memberList)
{
    <div class="member">
        <span>@member.FirstName @member.LastName</span>
        <span>@member.DateOfBirth.ToString("dd-MM-yyyy")</span>
        <span>@member.PhoneNumber</span>
        <span>@member.Username</span>
        <span>@(member.IsLeader ? "Leder" : "Spejder")</span>
        
        <a asp-page="/crud/MemberDetails" asp-route-id="@member.MemberId">Se Detaljer</a>
        
        <form method="post" asp-page-handler="ConfirmMemberDeletion" asp-route-id="@member.MemberId"
              onsubmit="return confirm('Er du sikker på, at du vil slette denne spejder?');">
            <button type="submit">Slet</button>
        </form>
        
    </div>
}
<!-- end -->



